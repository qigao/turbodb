{
  "name": "vcpkg-turbonet",
  "version-semver": "0.1.0",
  "dependencies": [
    {
      "name": "pkgconf",
      "host": true
    },
    "zstd"
  ],
  "features": {
    "sqlite": {
      "description": "Build SQLite ORM and database-tool backends",
      "dependencies": [
        "sqlite3"
      ]
    },
    "mongodb": {
      "description": "Build the optional runtime-loaded MongoDB ORM Driver",
      "dependencies": [
        "mongo-c-driver"
      ]
    },
    "postgresql": {
      "description": "Build the optional PostgreSQL ORM backend",
      "dependencies": [
        {
          "name": "libpq",
          "default-features": false,
          "features": [
            "zstd"
          ]
        }
      ]
    }
  },
  "builtin-baseline": "b1b19307e2d2ec1eefbdb7ea069de7d4bcd31f01"
}
