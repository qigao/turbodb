{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "USER_ROOT": "C:/Users/lockg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON",
                "TIDESDB_BUILD_TESTS": "OFF",
                "TIDESDB_WITH_SNAPPY": "OFF",
                "TIDESDB_WITH_LZ4": "OFF"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON",
                "TIDESDB_BUILD_TESTS": "OFF",
                "TIDESDB_WITH_SNAPPY": "OFF",
                "TIDESDB_WITH_LZ4": "OFF"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-win-paths",
            "hidden": true,
            "inherits": "ISWindows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "ORM_WITH_PGSQL": "ON",
                "TURBODB_BUILD_DBTOOLS": "ON",
                "TURBODB_DBTOOLS_WITH_SQLITE": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": ["base-win-dev-user", "win-paths"]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "ORM_WITH_PGSQL": "ON",
                "TURBODB_BUILD_DBTOOLS": "ON",
                "TURBODB_DBTOOLS_WITH_SQLITE": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb/release"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": ["base-win-release-user", "win-paths"]
        },
        {
            "name": "win-release-dbtools-pg-user",
            "displayName": "Release + PostgreSQL dbtools (Windows)",
            "inherits": "win-release-user",
            "binaryDir": "${sourceDir}/build/Msvc-Release-DbTools-PG",
            "cacheVariables": {
                "ORM_WITH_PGSQL": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_pg",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed_pg/x64-windows"
            },
            "environment": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_pg",
                "PATH": "${sourceDir}/build/Msvc-Release-DbTools-PG/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "win-release-pg-live-user",
            "displayName": "Release + PostgreSQL live tests (Windows)",
            "inherits": "win-release-dbtools-pg-user",
            "binaryDir": "${sourceDir}/build/Msvc-Release-PG",
            "cacheVariables": {
                "ORM_WITH_PGSQL": "ON",
                "ORM_POSTGRES_LIVE_TESTS": "ON",
                "TURBODB_DBTOOLS_PG_LIVE_TESTS": "ON"
            },
            "environment": {
                "PATH": "${sourceDir}/build/Msvc-Release-PG/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "ORM_WITH_PGSQL": "ON",
                "TURBODB_BUILD_DBTOOLS": "ON",
                "TURBODB_DBTOOLS_WITH_SQLITE": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": ["base-linux-dev-user", "linux-paths"]
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "ORM_WITH_PGSQL": "ON",
                "TURBODB_BUILD_DBTOOLS": "ON",
                "TURBODB_DBTOOLS_WITH_SQLITE": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb/release"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": ["release-linux-ninja", "linux-paths"]
        },
        {
            "name": "linux-release-pg-live-user",
            "displayName": "Release + PostgreSQL live tests (Linux)",
            "inherits": "linux-release-user",
            "binaryDir": "${sourceDir}/build/linux-gcc-release-pg",
            "cacheVariables": {
                "ORM_WITH_PGSQL": "ON",
                "ORM_POSTGRES_LIVE_TESTS": "ON",
                "TURBODB_DBTOOLS_WITH_PGSQL": "ON",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_pg",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed_pg/x64-linux"
            },
            "environment": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_pg",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release-pg/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils-android/debug"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb-android/debug",
                "ORM_WITH_PGSQL": "OFF",
                "TURBODB_BUILD_DBTOOLS": "OFF",
                "TURBODB_DBTOOLS_WITH_PGSQL": "OFF"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils-android/release"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb-android/release",
                "ORM_WITH_PGSQL": "OFF",
                "TURBODB_BUILD_DBTOOLS": "OFF",
                "TURBODB_DBTOOLS_WITH_PGSQL": "OFF"
            }
        },
        { "name": "android-arm64-v8a-debug-win", "inherits": ["android-arm64-v8a-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"] },
        { "name": "android-arm64-v8a-release-win", "inherits": ["android-arm64-v8a-release", "android-dependencies-release", "android-win-paths", "android-win-environment"] },
        { "name": "android-x86_64-debug-win", "inherits": ["android-x86_64-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"] },
        { "name": "android-x86_64-release-win", "inherits": ["android-x86_64-release", "android-dependencies-release", "android-win-paths", "android-win-environment"] },
        { "name": "android-x86-debug-win", "inherits": ["android-x86-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"] },
        { "name": "android-x86-release-win", "inherits": ["android-x86-release", "android-dependencies-release", "android-win-paths", "android-win-environment"] }
    ],
    "buildPresets": [
        { "name": "win-dev-user", "configurePreset": "win-dev-user" },
        { "name": "win-release-user", "configurePreset": "win-release-user" },
        { "name": "win-release-dbtools-pg-user", "configurePreset": "win-release-dbtools-pg-user" },
        { "name": "win-release-pg-live-user", "configurePreset": "win-release-pg-live-user" },
        { "name": "linux-dev-user", "configurePreset": "linux-dev-user" },
        { "name": "linux-release-user", "configurePreset": "linux-release-user" },
        { "name": "linux-release-pg-live-user", "configurePreset": "linux-release-pg-live-user" },
        { "name": "install-win-dev-user", "configurePreset": "win-dev-user", "targets": ["install"] },
        { "name": "install-win-release-user", "configurePreset": "win-release-user", "targets": ["install"] },
        { "name": "install-win-release-dbtools-pg-user", "configurePreset": "win-release-dbtools-pg-user", "targets": ["install"] },
        { "name": "install-win-release-pg-live-user", "configurePreset": "win-release-pg-live-user", "targets": ["install"] },
        { "name": "install-linux-dev-user", "configurePreset": "linux-dev-user", "targets": ["install"] },
        { "name": "install-linux-release-user", "configurePreset": "linux-release-user", "targets": ["install"] },
        { "name": "install-linux-release-pg-live-user", "configurePreset": "linux-release-pg-live-user", "targets": ["install"] },
        { "name": "android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win" },
        { "name": "android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win" },
        { "name": "android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win" },
        { "name": "android-x86_64-release-win", "configurePreset": "android-x86_64-release-win" },
        { "name": "android-x86-debug-win", "configurePreset": "android-x86-debug-win" },
        { "name": "android-x86-release-win", "configurePreset": "android-x86-release-win" },
        { "name": "install-android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win", "targets": ["install"] },
        { "name": "install-android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win", "targets": ["install"] },
        { "name": "install-android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win", "targets": ["install"] },
        { "name": "install-android-x86_64-release-win", "configurePreset": "android-x86_64-release-win", "targets": ["install"] },
        { "name": "install-android-x86-debug-win", "configurePreset": "android-x86-debug-win", "targets": ["install"] },
        { "name": "install-android-x86-release-win", "configurePreset": "android-x86-release-win", "targets": ["install"] }
    ],
    "testPresets": [
        { "name": "win-dev-user", "inherits": "base-test", "configurePreset": "win-dev-user" },
        { "name": "win-release-user", "inherits": "base-test", "configurePreset": "win-release-user" },
        { "name": "win-release-dbtools-pg-user", "inherits": "base-test", "configurePreset": "win-release-dbtools-pg-user" },
        { "name": "win-release-pg-live-user", "inherits": "base-test", "configurePreset": "win-release-pg-live-user" },
        { "name": "linux-dev-user", "inherits": "base-test", "configurePreset": "linux-dev-user" },
        { "name": "linux-release-user", "inherits": "base-test", "configurePreset": "linux-release-user" },
        { "name": "linux-release-pg-live-user", "inherits": "base-test", "configurePreset": "linux-release-pg-live-user" }
    ]
}
