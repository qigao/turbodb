            ]
        },
        {
            "name": "install-android-arm64-v8a-release-win",
            "configurePreset": "android-arm64-v8a-release-win",
            "targets": [
                "install"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "orm-win-release-user",
            "inherits": "orm-test",
            "configurePreset": "win-release-user"
        },
        {
            "name": "ci-windows-release",
            "inherits": "orm-test",
            "configurePreset": "ci-windows-release",
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "ci-linux-release",
            "inherits": "orm-test",
            "configurePreset": "ci-linux-release",
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "ci-linux-arm64-release",
            "inherits": "orm-test",
            "configurePreset": "ci-linux-arm64-release",
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "ci-macos-arm64-release",
            "inherits": "orm-test",
            "configurePreset": "ci-macos-arm64-release",
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "ci-linux-e2e",
            "inherits": "base-test",
            "configurePreset": "ci-linux-e2e",
            "execution": {
                "noTestsAction": "error"
            },
            "filter": {
                "include": {
                    "label": "e2e"
                }
            }
        },
        {
            "name": "win-dev-user",
            "inherits": "base-test",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "inherits": "base-test",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "inherits": "base-test",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "inherits": "base-test",
            "configurePreset": "linux-release-user"
        },
        {
            "name": "linux-release-pg-e2e-user",
            "inherits": "base-test",
            "configurePreset": "linux-release-pg-e2e-user",
            "filter": {
                "include": {
                    "label": "e2e",
                    "name": "^(dbtool_postgresql_live_test|orm_postgres_live|orm_owner_postgres|orm_owner_postgres_loss|orm_sql_validation_parity)$"
                }
            }
        }
    ]
}
