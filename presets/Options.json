{
  "version": 6,
  "configurePresets": [
    {
      "name": "default-options",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTS": "OFF",
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_SANITIZER_UNDEFINED": "OFF",
        "ENABLE_SANITIZER_THREAD": "OFF",
        "BUILD_EXAMPLE": "OFF"
      }
    },
    {
      "name": "developer-mode",
      "hidden": true,
      "inherits": "default-options",
      "environment": {
        "VCPKG_CONFIGURATION_SUBDIR": "debug/"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release-mode",
      "hidden": true,
      "inherits": "default-options",
      "environment": {
        "VCPKG_CONFIGURATION_SUBDIR": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan-mode",
      "hidden": true,
      "inherits": "developer-mode",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "tsan-mode",
      "hidden": true,
      "inherits": "developer-mode",
      "cacheVariables": {
        "ENABLE_SANITIZER_THREAD": "ON"
      }
    }
  ]
}
