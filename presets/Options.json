{
    "version": 6,
    "configurePresets": [
        {
            "name": "default-options",
            "hidden": true,
            "cacheVariables": {
                "BUILD_E2E_TESTS": false,
                "ENABLE_CLANG_TIDY_DEFAULT": false,
                "ENABLE_CPPCHECK_DEFAULT": false
            }
        },
        {
            "name": "pkg-conan",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{CONAN_INSTALL_ROOT}/conan_toolchain.cmake"
            }
        },
        {
            "name": "pkg-vcpkg",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_MANIFEST_MODE": true,
                "VCPKG_APPLOCAL_DEPS": false
            }
        },
        {
            "name": "cppcheck",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_CPPCHECK": "cppcheck;--inline-suppr"
            }
        },
        {
            "name": "clang-tidy",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--header-filter=^${sourceDir}/"
            }
        },
        {
            "name": "developer-mode",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "inherits": [
                "default-options"
            ]
        },
        {
            "name": "release-mode",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "inherits": [
                "default-options"
            ]
        }
    ]
}
