{
    "version": 6,
    "include": [
        "BasePresets.json"
    ],
    "configurePresets": [
        {
            "name": "android-base",
            "hidden": true,
            "inherits": ["flags-android", "android-vcpkg-chainload"],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "ANDROID_STL": "c++_shared",
                "ANDROID_PLATFORM": "android-24",
                "BUILD_TESTING": false,
                "BUILD_EXAMPLES": false,
                "BUILD_TESTS": true,
                "ENABLE_TESTS": true
            }
        },
        {
            "name": "android-vcpkg-chainload",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_MANIFEST_MODE": true
            }
        },
        {
            "name": "android-win-paths",
            "hidden": true,
            "inherits": "ISWindows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "$env{NINJA_ROOT}/ninja.exe",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbodb-android",
                "CMAKE_PREFIX_PATH": "$env{PROJECT_ROOT}/turbonet/turbo-utils/build/$env{ANDROID_BUILD_VARIANT};$env{PROJECT_ROOT}/turbonet/turbonet/build/$env{ANDROID_BUILD_VARIANT}",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "TURBO_UTILS_ROOT": "$env{PROJECT_ROOT}/turbonet/turbo-utils/build/$env{ANDROID_BUILD_VARIANT}",
                "TURBOPARSER_ROOT": "$env{PROJECT_ROOT}/turbonet/turbo-parser/build/$env{ANDROID_BUILD_VARIANT}",
                "TURBO_NET_ROOT": "$env{PROJECT_ROOT}/turbonet/turbonet/build/$env{ANDROID_BUILD_VARIANT}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "android-arm64-v8a-debug",
            "hidden": true,
            "inherits": ["android-base", "developer-mode"],
            "binaryDir": "${sourceDir}/build/android-arm64-v8a-debug",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-arm64-v8a-release",
            "hidden": true,
            "inherits": ["android-base", "release-mode"],
            "binaryDir": "${sourceDir}/build/android-arm64-v8a-release",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-x86_64-debug",
            "hidden": true,
            "inherits": ["android-base", "developer-mode"],
            "binaryDir": "${sourceDir}/build/android-x86_64-debug",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-x86_64-release",
            "hidden": true,
            "inherits": ["android-base", "release-mode"],
            "binaryDir": "${sourceDir}/build/android-x86_64-release",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-x86-debug",
            "hidden": true,
            "inherits": ["android-base", "developer-mode"],
            "binaryDir": "${sourceDir}/build/android-x86-debug",
            "cacheVariables": {
                "ANDROID_ABI": "x86",
                "VCPKG_TARGET_TRIPLET": "x86-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-x86-release",
            "hidden": true,
            "inherits": ["android-base", "release-mode"],
            "binaryDir": "${sourceDir}/build/android-x86-release",
            "cacheVariables": {
                "ANDROID_ABI": "x86",
                "VCPKG_TARGET_TRIPLET": "x86-android",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF"
            }
        }
    ]
}
