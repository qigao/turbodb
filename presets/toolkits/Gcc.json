{
  "version": 6,
  "configurePresets": [
    {
      "name": "toolkit-gcc",
      "hidden": true,
      "description": "GNU GCC on Linux/macOS; public profiles select compiler paths from the user environment",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "inherits": "ISPosix"
    },
    {
      "name": "toolkit-gcc-macos",
      "hidden": true,
      "inherits": "toolkit-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-15",
        "CMAKE_CXX_COMPILER": "g++-15"
      }
    },
    {
      "name": "flags-gnu",
      "hidden": true,
      "environment": {
        "SALTS_GNU_BRANCH_PROTECTION": "-fcf-protection=full"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fstack-protector-strong $env{SALTS_GNU_BRANCH_PROTECTION} -fstack-clash-protection -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS=1 -fstack-protector-strong $env{SALTS_GNU_BRANCH_PROTECTION} -fstack-clash-protection -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--allow-shlib-undefined,--as-needed,-z,noexecstack,-z,relro,-z,now",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--allow-shlib-undefined,--as-needed,-z,noexecstack,-z,relro,-z,now"
      }
    },
    {
      "name": "flags-gnu-arm64",
      "hidden": true,
      "inherits": "flags-gnu",
      "description": "AArch64 uses PAC/BTI branch protection instead of x86 CET",
      "environment": {
        "SALTS_GNU_BRANCH_PROTECTION": "-mbranch-protection=standard"
      }
    },
    {
      "name": "flags-gcc-macos",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
        "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions"
      }
    }
  ],
  "include": [
    "../Platforms.json"
  ]
}
