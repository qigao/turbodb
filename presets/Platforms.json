{
  "version": 6,
  "configurePresets": [
    {
      "name": "ISWindows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ISLinux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ISMac",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ISNative",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Windows",
          "Linux",
          "Darwin"
        ]
      }
    },
    {
      "name": "ISPosix",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-posix",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      }
    }
  ],
  "testPresets": [
    {
      "name": "test-posix",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      }
    }
  ]
}
