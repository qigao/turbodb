@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(TurboDB_FOUND FALSE)
  set(TurboDB_NOT_FOUND_MESSAGE
      "SALTS_ROOT must name the installed Salts profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" SALTS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_ROOT_PATH}")
  set(TurboDB_FOUND FALSE)
  set(TurboDB_NOT_FOUND_MESSAGE
      "SALTS_ROOT is not a directory: $ENV{SALTS_ROOT}")
  return()
endif()

find_dependency(Threads)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts CONFIG REQUIRED PATHS "${SALTS_ROOT_PATH}"
                NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/TurboDBTargets.cmake")
set(TurboDB_Redis_FOUND @TURBODB_BUILD_REDIS@)

check_required_components(TurboDB)
