@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_TurboDB_PREFIX "${PACKAGE_PREFIX_DIR}")
cmake_path(CONVERT "$ENV{SALTS_ROOT}" TO_CMAKE_PATH_LIST _TurboDB_SALTS_ROOT NORMALIZE)
find_dependency(Salts CONFIG REQUIRED PATHS "${_TurboDB_SALTS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(@TURBODB_BUILD_TIDESSQL@)
  set(TidesDB_DIR "${_TurboDB_PREFIX}/@CMAKE_INSTALL_LIBDIR@/cmake/tidesdb")
  find_dependency(TidesDB CONFIG REQUIRED NO_DEFAULT_PATH
    PATHS "${TidesDB_DIR}" NO_CMAKE_FIND_ROOT_PATH)
endif()
if(@TURBODB_BUILD_ORM@)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TurboDBTargets.cmake")
if(@TURBODB_BUILD_ORM@)
  include("${CMAKE_CURRENT_LIST_DIR}/OrmTargets.cmake")
  set(TurboDB_DRIVER_DIR "${_TurboDB_PREFIX}/@CMAKE_INSTALL_LIBDIR@/turbodb/drivers")
endif()
if(@TURBODB_BUILD_TIDESSQL@)
  include("${_TurboDB_PREFIX}/@CMAKE_INSTALL_LIBDIR@/cmake/TidesSQL/TidesSQLTargets.cmake")
endif()
unset(_TurboDB_SALTS_ROOT)
unset(_TurboDB_PREFIX)
check_required_components(TurboDB)
