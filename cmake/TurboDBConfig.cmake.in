@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_TurboDB_PREFIX "${PACKAGE_PREFIX_DIR}")
find_dependency(Salts CONFIG REQUIRED PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(@TURBODB_BUILD_ORM@)
  # The static MySQL client needs the producer's Crypto library at link time.
  # Resolve the bundled package rather than requiring a consumer SSL install.
  unset(OpenSSL_DIR CACHE)
  unset(OpenSSL_DIR)
  find_dependency(OpenSSL CONFIG REQUIRED
    PATHS "${_TurboDB_PREFIX}/share/OpenSSL" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  include("${CMAKE_CURRENT_LIST_DIR}/OrmTargets.cmake")
  set(TurboDB_DRIVER_DIR "${_TurboDB_PREFIX}/@CMAKE_INSTALL_LIBDIR@/turbodb/drivers")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TurboDBTargets.cmake")
unset(_TurboDB_PREFIX)
check_required_components(TurboDB)
