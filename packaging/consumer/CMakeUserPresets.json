{
  "version": 6,
  "include": [
    "../../CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "consumer-windows",
      "inherits": "ci-windows-release",
      "binaryDir": "${sourceDir}/../../build/consumer-windows",
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../build/consumer-windows-vcpkg",
        "PATH": "$env{TURBODB_ROOT}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "BUILD_TESTS": null,
        "BUILD_E2E_TESTS": null,
        "BUILD_EXAMPLES": null,
        "TIDESDB_BUILD_TESTS": null,
        "TIDESDB_WITH_SNAPPY": null,
        "TIDESDB_WITH_LZ4": null,
        "TURBODB_BUILD_ORM": null,
        "TURBODB_BUILD_DBTOOLS": null,
        "PKG_CONFIG_EXECUTABLE": null
      }
    },
    {
      "name": "consumer-linux",
      "inherits": "ci-linux-release",
      "binaryDir": "${sourceDir}/../../build/consumer-linux",
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../build/consumer-linux-vcpkg",
        "LD_LIBRARY_PATH": "$env{TURBODB_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "BUILD_TESTS": null,
        "BUILD_E2E_TESTS": null,
        "BUILD_EXAMPLES": null,
        "TIDESDB_BUILD_TESTS": null,
        "TIDESDB_WITH_SNAPPY": null,
        "TIDESDB_WITH_LZ4": null,
        "TURBODB_BUILD_ORM": null,
        "TURBODB_BUILD_DBTOOLS": null,
        "PKG_CONFIG_EXECUTABLE": null
      }
    },
    {
      "name": "consumer-android",
      "inherits": "ci-android-release",
      "binaryDir": "${sourceDir}/../../build/consumer-android",
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../build/consumer-android-vcpkg",
        "LD_LIBRARY_PATH": "$env{TURBODB_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "BUILD_TESTS": null,
        "BUILD_E2E_TESTS": null,
        "BUILD_EXAMPLES": null,
        "TIDESDB_BUILD_TESTS": null,
        "TIDESDB_WITH_SNAPPY": null,
        "TIDESDB_WITH_LZ4": null,
        "TURBODB_BUILD_ORM": null,
        "TURBODB_BUILD_DBTOOLS": null,
        "PKG_CONFIG_EXECUTABLE": null
      }
    }
  ],
  "buildPresets": [
    {
      "name": "consumer-windows",
      "configurePreset": "consumer-windows"
    },
    {
      "name": "consumer-linux",
      "configurePreset": "consumer-linux"
    },
    {
      "name": "consumer-android",
      "configurePreset": "consumer-android"
    }
  ],
  "testPresets": [
    {
      "name": "consumer-windows",
      "configurePreset": "consumer-windows",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "consumer-linux",
      "configurePreset": "consumer-linux",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
