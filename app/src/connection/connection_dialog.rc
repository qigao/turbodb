#include <windows.h>
#include "connection_resource.h"

IDD_STUDIO_CONNECTION DIALOGEX 0, 0, 392, 383
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "New Connection"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "  Connection", IDC_CONNECTION_DRIVER_SECTION, 12, 10, 368, 12, SS_CENTERIMAGE
    LTEXT "P&rofile:", -1, 12, 31, 86, 12
    COMBOBOX IDC_CONNECTION_PROFILE, 102, 28, 216, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Load INI...", IDC_CONNECTION_CONFIG_LOAD, 324, 27, 56, 18
    LTEXT "&Driver:", -1, 12, 59, 86, 12
    COMBOBOX IDC_CONNECTION_DRIVER, 102, 56, 278, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Display &name:", -1, 12, 80, 86, 12
    EDITTEXT IDC_CONNECTION_NAME, 102, 77, 278, 15, ES_AUTOHSCROLL
    LTEXT "  Database", IDC_CONNECTION_DATABASE_SECTION, 12, 103, 368, 12, SS_CENTERIMAGE
    LTEXT "Database &file:", IDC_CONNECTION_DATABASE_LABEL, 12, 124, 86, 12
    EDITTEXT IDC_CONNECTION_DATABASE, 102, 121, 216, 15, ES_AUTOHSCROLL
    PUSHBUTTON "&Select...", IDC_CONNECTION_DATABASE_BROWSE, 324, 120, 56, 18
    LTEXT "&Host:", IDC_CONNECTION_HOST_LABEL, 12, 145, 86, 12
    EDITTEXT IDC_CONNECTION_HOST, 102, 142, 169, 15, ES_AUTOHSCROLL
    LTEXT "&Port:", IDC_CONNECTION_PORT_LABEL, 281, 145, 27, 12
    EDITTEXT IDC_CONNECTION_PORT, 312, 142, 68, 15, ES_AUTOHSCROLL
    LTEXT "&User:", IDC_CONNECTION_USER_LABEL, 12, 166, 86, 12
    EDITTEXT IDC_CONNECTION_USER, 102, 163, 278, 15, ES_AUTOHSCROLL
    LTEXT "Pass&word:", IDC_CONNECTION_PASSWORD_LABEL, 12, 187, 86, 12
    EDITTEXT IDC_CONNECTION_PASSWORD, 102, 184, 278, 15, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "  Server verification", IDC_CONNECTION_TLS_SECTION, 12, 210, 368, 12, SS_CENTERIMAGE
    LTEXT "&CA certificate:", IDC_CONNECTION_CA_LABEL, 12, 231, 86, 12
    EDITTEXT IDC_CONNECTION_CA, 102, 228, 216, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Choose...", IDC_CONNECTION_CA_BROWSE, 324, 227, 56, 18
    LTEXT "TLS server na&me:", IDC_CONNECTION_SERVER_LABEL, 12, 252, 86, 12
    EDITTEXT IDC_CONNECTION_SERVER, 102, 249, 278, 15, ES_AUTOHSCROLL
    LTEXT "", IDC_CONNECTION_HINT, 12, 272, 368, 22
    LTEXT "Connection needs attention", IDC_CONNECTION_ERROR_LABEL, 12, 300, 368, 12
    EDITTEXT IDC_CONNECTION_ERROR, 12, 314, 368, 30, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "&Connect", IDOK, 260, 351, 56, 20
    PUSHBUTTON "Cancel", IDCANCEL, 324, 351, 56, 20
END
