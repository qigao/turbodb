{
  "targets": {
    "dbtool_orm_plugins_test": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "native": true
      },
      "sources": {
        "files": ["dbtool_orm_plugins_test.c"]
      },
      "private": {
        "deps": ["turbodb_dbtool_core", "saltsbase_tinytest"]
      },
      "runtimeDeps": ["turbodb_driver_sqlite", "turbodb_driver_postgresql", "turbodb_driver_mysql"],
      "variants": [
        {
          "when": {
            "os": "windows"
          },
          "private": {
            "defines": {
              "DBTOOL_MYSQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_mysql.dll\"",
              "DBTOOL_POSTGRESQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_postgresql.dll\"",
              "DBTOOL_SQLITE_PLUGIN": "\"$builddir/plugins/turbodb_driver_sqlite.dll\""
            }
          }
        },
        {
          "when": {
            "os": ["linux", "android"]
          },
          "private": {
            "defines": {
              "DBTOOL_MYSQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_mysql.so\"",
              "DBTOOL_POSTGRESQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_postgresql.so\"",
              "DBTOOL_SQLITE_PLUGIN": "\"$builddir/plugins/turbodb_driver_sqlite.so\""
            }
          }
        },
        {
          "when": {
            "os": "macos"
          },
          "private": {
            "defines": {
              "DBTOOL_MYSQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_mysql.dylib\"",
              "DBTOOL_POSTGRESQL_PLUGIN": "\"$builddir/plugins/turbodb_driver_postgresql.dylib\"",
              "DBTOOL_SQLITE_PLUGIN": "\"$builddir/plugins/turbodb_driver_sqlite.dylib\""
            }
          }
        }
      ],
      "test": {
        "name": "dbtool_orm_plugins_test",
        "labels": ["local"]
      }
    },
