          "saltsbase_tinytest",
          "turbodb_types"
        ],
        "includeDirs": ["../../include/orm", "../../src/abi", "../../src/flow", "../../src/driver"],
        "defines": {
          "ORM_C_STATIC": null,
          "ORM_NATIVE_OWNER_CANDIDATE": null
        }
      },
      "variants": [
        {
          "when": {
            "driver": ["llvm-mingw", "gcc", "clang"]
          },
          "private": {
            "flags": ["-Werror"]
          }
        },
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": ["/WX"]
          }
        }
      ],
      "test": {
        "name": "orm_driver_backend_adapter",
        "labels": ["local"]
      }
