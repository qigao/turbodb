{
  "targets": {
    "orm_owner_postgres_loss_test": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "native": true
      },
      "sources": {
        "files": ["orm_owner_postgres_loss_test.c"]
      },
      "private": {
        "deps": [
          "turbo_orm",
          "postgresql",
          "saltsutils_databind",
          "cmeta_cflow",
          "saltsbase_tinytest",
          "turbodb_types"
        ],
        "defines": {
          "ORM_NATIVE_OWNER_CANDIDATE": null
        },
        "includeDirs": ["../../../src/abi", "../../../src/flow"]
      },
      "runtimeDeps": ["turbodb_driver_postgresql"],
      "variants": [
        {
          "when": {
            "driver": ["llvm-mingw", "gcc", "clang"]
          },
          "private": {
            "flags": ["-Werror"]
          }
        },
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": ["/WX"]
          }
        }
      ],
      "test": {
        "name": "orm_owner_postgres_loss",
        "labels": ["e2e"],
        "timeout": 60,
        "tool": "cmake",
        "args": [
          "-P",
          "$root/cmake/RunSlateTest.cmake",
          "$target",
          "ORM_POSTGRESQL_PLUGIN",
          "${artifact:turbodb_driver_postgresql}",
          "--"
        ]
      }
    },
