  "targets": {
    "orm_owner_checked_test": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "native": true
      },
      "sources": {
        "files": [
          "orm_owner_test.c",
          "orm_transaction_owner_test.c",
          "orm_connection_control_test.c",
          "orm_cursor_open_owner_test.c",
          "orm_cursor_execution_owner_test.c",
          "orm_row_storage_cutover_test.c",
          "orm_row_budget_owner_test.c",
          "orm_row_borrowed_contract_test.c"
        ]
      },
      "private": {
        "deps": [
          "orm_owner_test_core",
          "saltsutils_databind",
          "cmeta_cflow",
          "saltsbase_tinytest",
          "turbodb_types"
        ],
        "defines": {
          "ORM_C_STATIC": null,
          "ORM_NATIVE_OWNER_CANDIDATE": null
        },
        "includeDirs": ["../../src/abi", "../../src/flow"]
      },
      "variants": [
        {
          "when": {
            "driver": ["llvm-mingw", "gcc", "clang"]
          },
          "private": {
            "flags": ["-Werror"]
          }
        },
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": ["/WX"]
          }
        }
      ],
      "test": {
        "name": "orm_owner_checked",
        "labels": ["local"],
        "timeout": 60
      }
    },
