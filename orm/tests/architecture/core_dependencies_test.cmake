# Database clients belong to loadable drivers, not the generic ORM runtime.
if(CMAKE_HOST_WIN32)
  find_program(inspector dumpbin REQUIRED)
  set(arguments /DEPENDENTS)
else()
  find_program(inspector readelf REQUIRED)
  set(arguments -d)
endif()
execute_process(COMMAND "${inspector}" ${arguments} "${ORM_CORE}"
  OUTPUT_VARIABLE dependencies ERROR_VARIABLE error RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot inspect ${ORM_CORE}: ${error}")
endif()
string(TOLOWER "${dependencies}" dependencies)
if(CMAKE_HOST_WIN32)
  string(REGEX MATCHALL "[\r\n][ \t]+[a-z0-9_.+-]+\\.dll" imports "${dependencies}")
else()
  string(REGEX MATCHALL "\\(needed\\)[^\n]+" imports "${dependencies}")
endif()
if(NOT imports)
  message(FATAL_ERROR "No dynamic dependencies found for ${ORM_CORE}")
endif()
foreach(dependency IN LISTS imports)
  if(dependency MATCHES "sqlite|libpq|postgres|tidesdb|tedis|libmysql|mariadb|mongoc|bson")
    message(FATAL_ERROR "Generic ORM imports a database client: ${dependency}")
  endif()
endforeach()
