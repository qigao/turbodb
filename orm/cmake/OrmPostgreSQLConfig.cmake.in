@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Orm CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../Orm"
                NO_DEFAULT_PATH)
if(NOT @ORM_BUILD_SHARED@)
  find_dependency(PostgreSQL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OrmPostgreSQLTargets.cmake")
check_required_components(OrmPostgreSQL)
