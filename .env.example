VCPKG_CACHE_VERSION=0.1.9
SALTS_BASE_VERSION=0.1.11
CMETA_VERSION=0.1.11
SALTS_UTILS_VERSION=0.1.10
SALTS_CNET_VERSION=0.1.20
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_INSTALLED_DIR=C:/path/to/preinstalled-vcpkg/vcpkg_installed
SALTS_BASE_ROOT=C:/path/to/salts-base-0.1.11-sdk
CMETA_ROOT=C:/path/to/cmeta-0.1.11-sdk
SALTS_UTILS_ROOT=C:/path/to/salts-utils-0.1.10-sdk
SALTS_CNET_ROOT=C:/path/to/salts-cnet-0.1.20-sdk
TURBODB_RE2C_ROOT=C:/path/to/re2c/tools/windows-x64
LEMON_ROOT=C:/path/to/lemon/tools/windows-x64
VSDEVCMD_BAT=C:/path/to/Visual Studio/Common7/Tools/VsDevCmd.bat

# Load these build settings into the parent environment before running CMake.
# Each SDK root must match its selected version and the preset's compiler/target.
# CMake never reads .env implicitly. Keep credentials and local paths untracked.

# Compiler and target selection belongs to presets. For LLVM-MinGW, supply only
# the installed compiler root. CMake consumes the prepared dependency prefix
# directly; no generated toolchain paths belong in .env.
# LLVM_MINGW_ROOT=C:/tools/llvm-mingw

# Slate MSVC presets select a separate x64-windows cache and SDK set.
# The vcpkg tree must also have the Scintilla and Lexilla Studio ports.
# TURBODB_MSVC_VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-x64-windows/payload/vcpkg_installed
# TURBODB_MSVC_SALTS_BASE_ROOT=C:/sdk/salts-base-0.1.11-windows-msvc-x64
# TURBODB_MSVC_CMETA_ROOT=C:/sdk/cmeta-0.1.11-windows-msvc-x64
# TURBODB_MSVC_SALTS_UTILS_ROOT=C:/sdk/salts-utils-0.1.10-windows-msvc-x64
# TURBODB_MSVC_SALTS_CNET_ROOT=C:/sdk/salts-cnet-0.1.20-windows-msvc-x64
