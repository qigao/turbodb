    "postgresql": {
      "kind": "prebuilt",
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "public": {
            "requiredIncludeDirs": ["$vcpkg/include"],
            "libs": ["$vcpkg/lib/libpq.lib"]
          },
          "runtimeBins": ["$vcpkg/bin/libpq.dll"]
        },
        {
          "when": {
            "driver": "llvm-mingw"
          },
          "public": {
            "requiredIncludeDirs": ["$vcpkg/include"],
            "libs": ["$vcpkgConfig/lib/libpq.dll.a"]
          },
          "runtimeBins": ["$vcpkgConfig/bin/libpq.dll"]
        },
        {
          "when": {
            "os": ["linux", "macos", "android"]
          },
          "package": {
            "provider": "vcpkg",
            "name": "postgresql",
            "pc": "libpq",
            "static": true
          }
        }
      ]
    },
