          "CFLOW_MACHINE_MAX_GUARDS": "65536",
          "CFLOW_MACHINE_MAX_ACTIONS": "65536",
          "CFLOW_MACHINE_MAX_TRANSITIONS": "1048576",
          "CFLOW_STATECHART_MAX_ACTION_REFS": "1048576",
