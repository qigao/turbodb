            "requiredIncludeDirs": ["${envPath:SALTS_CNET_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:SALTS_CNET_ROOT}/lib/libsalts_crypto.so"]
        },
        {
          "when": {
            "os": "macos"
          },
          "public": {
            "libs": ["${envPath:SALTS_CNET_ROOT}/lib/libsalts_crypto.dylib"],
            "requiredIncludeDirs": ["${envPath:SALTS_CNET_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:SALTS_CNET_ROOT}/lib/libsalts_crypto.dylib"]
        },
        {
          "when": {
            "os": "windows"
